def _payload():
    blob = base64.b64decode(ARCHIVE_BASE64)
    if hashlib.sha256(blob).hexdigest() != ARCHIVE_SHA256:
        raise RuntimeError('Packed game archive failed SHA-256 verification')
    return blob

def _safe_extract(blob, destination):
    root = pathlib.Path(destination).resolve()
    with zipfile.ZipFile(io.BytesIO(blob)) as z:
        if z.testzip() is not None:
            raise RuntimeError('Packed game archive contains damaged files')
        if len(z.infolist()) > 180 or sum(i.file_size for i in z.infolist()) > 16000000:
            raise RuntimeError("Packed runtime exceeds extraction limits")
        for item in z.infolist():
            path = pathlib.PurePosixPath(item.filename)
            if path.is_absolute() or not path.parts or '..' in path.parts or '\\\\' in item.filename:
                raise RuntimeError('Unsafe archive member name')
            if (item.external_attr >> 16) & 0o170000 == 0o120000:
                raise RuntimeError('Symlink archive members not permitted')
            target = (root / pathlib.Path(*path.parts)).resolve()
            if target != root and root not in target.parents:
                raise RuntimeError('Unsafe archive member path')
        z.extractall(str(root))
    import json
    manifest = json.loads((root/'G18_RUNTIME_SHA256.json').read_text(encoding='utf8'))
    for name, expected in manifest.items():
        p = root / name
        if not p.is_file() or hashlib.sha256(p.read_bytes()).hexdigest() != expected:
            raise RuntimeError('Source integrity error: '+name)
    return len(manifest)

def _arguments(argv):
    parser = argparse.ArgumentParser(description='G18 PersonaCom x IHatov compact one-file game')
    action = parser.add_mutually_exclusive_group()
    action.add_argument('--doctor', action='store_true', help='Check Python, installed game and manuscript integrity')
    action.add_argument('--quickstart', action='store_true', help='Display a short starter guide')
    action.add_argument('--verify', action='store_true', help='Verify bundled source, resources, and story')
    action.add_argument('--self-test', action='store_true', help='Run the complete bundled regression suite')
    action.add_argument('--extract', metavar='EMPTY_DIRECTORY', help='Unpack all source files and resources for inspection')
    parser.add_argument('--classic', action='store_true', help='Run the original command-line interface')
    return parser.parse_args(argv)

def main(argv=None):
    args = _arguments(sys.argv[1:] if argv is None else argv)
    blob = _payload()
    if args.extract:
        target = pathlib.Path(args.extract).expanduser().resolve()
        if target.exists() and any(target.iterdir()):
            raise RuntimeError('Extract target must be an empty directory')
        target.mkdir(parents=True, exist_ok=True)
        count = _safe_extract(blob, target)
        print('Extracted and verified %d files at %s' % (count, target))
        return 0
    with tempfile.TemporaryDirectory(prefix='shiguan_g17_') as temp:
        root=pathlib.Path(temp)
        count=_safe_extract(blob, root)
        if args.quickstart:
            print('SHI GUAN × IHATOV — QUICK START\n1. Launch: python Shi_Guan_PersonaCom_G18_Compact.py\n2. At MAIN > type coach\n3. Type ihatov routes, then ihatov start duck\n4. Type engines install discovery, then engines explore\n5. Type ihatov progress and ihatov complete\n6. Type save to retain progress\nHelp: guide | voice biscuit | voice pebbles | release audit\nTest: --doctor or --self-test')
            return 0
        if args.doctor:
            from json import loads
            data=loads((root/'novel_data.json').read_text(encoding='utf8'))
            print('DIAGNOSTICS OK | Python %s | %d source files | %d original story sections' % (sys.version.split()[0],count,len(data['sections'])))
            print('Manuscript SHA256: %s' % hashlib.sha256((root/'novel_data.json').read_bytes()).hexdigest())
            path=pathlib.Path(__file__).resolve().parent
            print('Save folder: %s' % path)
            print('Existing save: %s' % ((path/'peach_save.json').is_file()))
            print('Full game tests: use --self-test')
            return 0
        if args.verify:
            from json import loads
            story=root/'novel_data.json'
            data=loads(story.read_text(encoding='utf8'))
            print('VERIFY OK | %d files | %d original manuscript sections | SHA-256 %s' %
                  (count, len(data['sections']), hashlib.sha256(story.read_bytes()).hexdigest()))
            return 0
        if args.self_test:
            old_cwd=os.getcwd()
            try:
                os.chdir(str(root));sys.path.insert(0,str(root))
                suite=unittest.defaultTestLoader.discover(str(root),pattern='test_*.py',top_level_dir=str(root))
                result=unittest.TextTestRunner(verbosity=1).run(suite)
                return 0 if result.wasSuccessful() else 1
            finally:
                os.chdir(old_cwd)
                if sys.path and sys.path[0]==str(root):sys.path.pop(0)
        old_cwd=os.getcwd()
        save_path=pathlib.Path(__file__).resolve().parent/'peach_save.json'
        # Existing overrides remain supported for deliberate save migration.
        if not os.environ.get('PEACH_GAME_SAVE'):
            os.environ['PEACH_GAME_SAVE']=str(save_path)
        sys.path.insert(0,str(root))
        try:
            sys.argv=[str(root/'peach_tree_shi_guan.py')] + (['--classic'] if args.classic else [])
            runpy.run_path(str(root/'peach_tree_shi_guan.py'),run_name='__main__')
            return 0
        finally:
            if sys.path and sys.path[0]==str(root):sys.path.pop(0)
            os.chdir(old_cwd)

if __name__=='__main__':
    try:sys.exit(main())
    except (OSError,ValueError,RuntimeError,zipfile.BadZipFile) as exc:
        print('G18 launch failed: %s' % exc,file=sys.stderr);sys.exit(1)

